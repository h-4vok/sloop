{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sloop.agent-output/worker/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findingResolutions", "verification", "guide"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "findingResolutions": { "type": "array" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "steps", "expected", "isolation", "limitations", "checklist"]
    }
  }
}
