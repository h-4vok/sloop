{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": ["test/**/*.test.mjs", "integration/**/*.test.mjs"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "style": {
        "useConst": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": { "kind": "objectLiteralMember" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE", "snake_case"]
              },
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "function" },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": { "kind": "functionParameter" },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": { "kind": "catchParameter" },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
