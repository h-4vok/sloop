{
  "name": "sloop",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sloop": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "arbiter-fixture": "node arbiter-fixture.cjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run build && vitest run test",
    "coverage": "npm run build && vitest run test --coverage",
    "pr-checks": "npm run format:check && npm run typecheck && npm test && npm run coverage && npm run build",
    "check": "npm test",
    "test:integration": "npm run build && vitest run integration",
    "sloop": "node dist/cli.js",
    "link:local": "npm unlink --global sloop && npm run build && npm link",
    "unlink:local": "npm unlink --global sloop",
    "help": "node dist/cli.js --help",
    "version": "node dist/cli.js --version",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
