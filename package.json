{
  "name": "sloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sloop": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "loop": "node dist/cli.js",
    "sloop": "node dist/cli.js",
    "link:local": "npm run build && npm link",
    "unlink:local": "npm unlink --global sloop",
    "help": "node dist/cli.js --help",
    "version": "node dist/cli.js --version",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@openai/codex": "^0.149.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0"
  }
}
